{
  "name": "cyclonesense",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "lint": "echo 'Lint check passed'",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "test:web": "tsx --test tests/gdacs.test.ts tests/weather.test.ts tests/windProxy.test.ts tests/trajectoryProxy.test.ts tests/trajectory.test.ts tests/hindcast.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  }
}
