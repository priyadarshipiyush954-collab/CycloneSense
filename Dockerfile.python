# CycloneSense AI - Python FastAPI & ML Engine Dockerfile
FROM python:3.15-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements (the full ML stack: this image runs the whole API)
COPY requirements.txt requirements-ml.txt ./
RUN pip install --no-cache-dir -r requirements-ml.txt

# Copy application, ML, and data processing code
COPY app/ ./app/
COPY ml/ ./ml/
COPY data/ ./data/
COPY models/multiyear45_resnet18_ir_weighted.pt ./models/multiyear45_resnet18_ir_weighted.pt
COPY run_server.py .

EXPOSE 8000

# Bind to 0.0.0.0 so any device on the network can access the API
CMD ["python", "run_server.py", "--host", "0.0.0.0", "--port", "8000"]
